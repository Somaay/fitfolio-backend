# Copy to .env and fill in. NEVER commit a real .env.
# Every value here is a placeholder: there are no working credentials in this file.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
API_PORT=8080
# Production: https://fitfolio.health (the API refuses an http:// origin in production,
# because the session cookie is Secure and would never be sent).
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ---------------------------------------------------------------- database
# The API and worker use RESTRICTED logins that cannot bypass row-level security.
# MIGRATION_DATABASE_URL is used only by `npm run db:migrate` and role provisioning.
MIGRATION_DATABASE_URL=postgresql://postgres:4aNeVTbyOGgvDp7j@db.zxckhtufhrmwuowcmmwo.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:4aNeVTbyOGgvDp7j@db.zxckhtufhrmwuowcmmwo.supabase.co:5432/postgres
WORKER_DATABASE_URL=postgresql://postgres:4aNeVTbyOGgvDp7j@db.zxckhtufhrmwuowcmmwo.supabase.co:5432/postgres
API_DB_USER=hi_api
API_DB_PASSWORD=CHANGE_ME
WORKER_DB_USER=hi_worker
WORKER_DB_PASSWORD=CHANGE_ME

# ------------------------------------------------------------------- auth
# password = first-party email + password, hashed with scrypt
# oidc     = external identity provider, verified against its JWKS
# supabase = Supabase authentication using SUPABASE_JWT_SECRET
# jwt      = Custom JWT tokens using JWT_SECRET
# There is no development bypass mode.
AUTH_MODE=jwt
JWT_SECRET=super-secret-random-key-that-is-at-least-32-characters-long-12345

# Failed sign-ins before the CREDENTIAL locks (not the IP, so rotating
# addresses does not reset the budget), and how long the lock lasts.
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCK_SECONDS=900

# How long a password reset link stays valid, in seconds.
PASSWORD_RESET_TTL_SECONDS=1800
SESSION_COOKIE_NAME=hi_session
# 32+ random bytes, base64. Generate: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_OF_RANDOM
SESSION_TTL_HOURS=12

# Required when AUTH_MODE=oidc. Production fails to start without these.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Required when AUTH_MODE=supabase.
SUPABASE_JWT_SECRET=RoLExSOvcRFbZoOPGNqBcNxMsTYh0IqJbk5hVispOYHuwJJlb9mNWb/cJ+OLaxjgVHDzl1bbL8nwrmvJvgy/lA==

# ---------------------------------------------------------- notifications
# log    = write a redacted line locally. NOT real delivery; refused in production.
# none   = drop everything, deliberately.
# resend = real email via Resend. Requires RESEND_API_KEY and NOTIFICATION_FROM,
#          and the FROM domain must be verified in your Resend dashboard
#          (SPF + DKIM DNS records). Without verification Resend only delivers
#          to your own account address.
NOTIFICATION_ADAPTER=log

# Required when NOTIFICATION_ADAPTER=resend. The worker refuses to start without
# both, rather than silently dropping password-reset links.
# The sending domain is fitfolio.health — it must be verified in Resend first.
RESEND_API_KEY=
NOTIFICATION_FROM=Fitfolio <no-reply@fitfolio.health>

# ------------------------------------------------------------------ worker
WORKER_POLL_INTERVAL_MS=2000
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=5
